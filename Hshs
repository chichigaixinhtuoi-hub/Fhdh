local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local activeNPC = false
local godModeActive = false
local shiftLockActive = false
local healthConnection = nil

-- Thống báo trạng thái ra Console
local function notify(text)
	print("[Script]: " .. text)
end

-- ==================== 1. NPC COLLAPSE (Phím Y) ====================
local function applyCollapse(humanoid)
	local character = humanoid.Parent
	if not character then return end
	
	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		humanoid.PlatformStand = activeNPC
		local hrp = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
		if hrp and activeNPC then
			hrp.Velocity = Vector3.new(0, -10, 0)
		end
	end
end

local function toggleNPC()
	activeNPC = not activeNPC
	notify("NPC Collapse: " .. (activeNPC and "ON" or "OFF"))
	if not activeNPC then
		for _, descendant in pairs(workspace:GetDescendants()) do
			if descendant:IsA("Humanoid") then
				local character = descendant.Parent
				local player = Players:GetPlayerFromCharacter(character)
				if not player then
					descendant.PlatformStand = false
				end
			end
		end
	end
end

task.spawn(function()
	while true do
		if activeNPC then
			for _, descendant in pairs(workspace:GetDescendants()) do
				if descendant:IsA("Humanoid") then
					applyCollapse(descendant)
				end
			end
		end
		task.wait(0.2)
	end
end)

-- ==================== 2. GOD MODE CHỐNG ĐẨY/KÉO (Phím L) ====================
local function toggleGodMode()
	godModeActive = not godModeActive
	notify("God Mode: " .. (godModeActive and "ON" or "OFF"))
	
	local character = LocalPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	
	if godModeActive then
		if humanoid then
			humanoid.MaxHealth = 9e9
			humanoid.Health = 9e9
			
			healthConnection = humanoid.HealthChanged:Connect(function()
				if godModeActive and humanoid.Health < humanoid.MaxHealth then
					humanoid.Health = humanoid.MaxHealth
				end
			end)
		end
		
		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanTouch = false
				for _, child in pairs(part:GetChildren()) do
					if child:IsA("BodyMover") or child:IsA("VectorForce") or child:IsA("LinearVelocity") then
						child:Destroy()
					end
				end
			end
		end
	else
		if healthConnection then
			healthConnection:Disconnect()
			healthConnection = nil
		end
		
		if humanoid then
			humanoid.MaxHealth = 100
			humanoid.Health = 100
		end
		
		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanTouch = true
			end
		end
	end
end

-- Vòng lặp xóa sạch lực đẩy/kéo lạ liên tục
RunService.Stepped:Connect(function()
	if godModeActive then
		local character = LocalPlayer.Character
		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health < humanoid.MaxHealth then
				humanoid.Health = humanoid.MaxHealth
			end
			
			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					if part.CanTouch then part.CanTouch = false end
					for _, child in pairs(part:GetChildren()) do
						if child:IsA("BodyMover") or child:IsA("VectorForce") or child:IsA("LinearVelocity") or child:IsA("AlignPosition") then
							child:Destroy()
						end
					end
				end
			end
		end
	end
end)

-- ==================== 3. SHIFTLOCK (Phím Left Shift) ====================
local function toggleShiftLock()
	shiftLockActive = not shiftLockActive
	notify("Shiftlock: " .. (shiftLockActive and "ON" or "OFF"))
end

RunService.RenderStepped:Connect(function()
	if shiftLockActive then
		local character = LocalPlayer.Character
		if character then
			local hrp = character:FindFirstChild("HumanoidRootPart")
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if hrp and humanoid then
				humanoid.AutoRotate = false
				local camera = workspace.CurrentCamera
				local camLookVector = camera.CFrame.LookVector
				local newLookVector = Vector3.new(camLookVector.X, 0, camLookVector.Z).Unit
				hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + newLookVector)
			end
		end
	else
		local character = LocalPlayer.Character
		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.AutoRotate = true
			end
		end
	end
end)

-- ==================== LẮNG NGHE PHÍM BẤM (PC) ====================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	-- Phím Y: Bật/Tắt NPC Collapse
	if input.KeyCode == Enum.KeyCode.Y then
		toggleNPC()
		
	-- Phím L: Bật/Tắt God Mode
	elseif input.KeyCode == Enum.KeyCode.L then
		toggleGodMode()
		
	-- Phím Left Shift: Bật/Tắt Shiftlock
	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		toggleShiftLock()
	end
end)

-- Reset trạng thái khi hồi sinh
LocalPlayer.CharacterAdded:Connect(function()
	godModeActive = false
	shiftLockActive = false
	if healthConnection then
		healthConnection:Disconnect()
		healthConnection = nil
	end
end)
